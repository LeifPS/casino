{
  "name": "casino",
  "main": "./src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "POKER", "class_name": "PokerTisch" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PokerTisch"] }]
}
